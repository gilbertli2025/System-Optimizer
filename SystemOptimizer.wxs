<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="System Optimizer"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="System Optimizer"
           UpgradeCode="A175C7C7-686B-4E89-9321-4745312160A4">

    <Package InstallerVersion="200" Platform="x64"
             Compressed="yes"
             InstallScope="perMachine"
             Manufacturer="System Optimizer"
             Description="System Optimizer - one GUI to tune performance, harden security, and restore everything to defaults."
             Keywords="optimize security services hardening windows" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of System Optimizer is already installed." />

    <Media Id="1" Cabinet="so.cab" EmbedCab="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="System Optimizer">
          <Component Id="AppExe" Guid="*" Win64="yes">
            <File Id="AppExe"
                  Name="SystemOptimizer.exe"
                  Source="$(var.SourceDir)\SystemOptimizer.exe"
                  KeyPath="yes" />
          </Component>
          <Directory Id="LibFolder" Name="lib">
            <Component Id="LibCommon" Guid="*" Win64="yes">
              <File Id="LibCommon"
                    Name="Common.ps1"
                    Source="$(var.SourceDir)\lib\Common.ps1"
                    KeyPath="yes" />
            </Component>
            <Component Id="LibService" Guid="*" Win64="yes">
              <File Id="LibService"
                    Name="ServiceCatalog.ps1"
                    Source="$(var.SourceDir)\lib\ServiceCatalog.ps1" />
            </Component>
            <Component Id="LibSecurity" Guid="*" Win64="yes">
              <File Id="LibSecurity"
                    Name="SecurityItems.ps1"
                    Source="$(var.SourceDir)\lib\SecurityItems.ps1" />
            </Component>
            <Component Id="LibMaint" Guid="*" Win64="yes">
              <File Id="LibMaint"
                    Name="MaintenanceItems.ps1"
                    Source="$(var.SourceDir)\lib\MaintenanceItems.ps1" />
            </Component>
            <Component Id="LibRepair" Guid="*" Win64="yes">
              <File Id="LibRepair"
                    Name="Repair.ps1"
                    Source="$(var.SourceDir)\lib\Repair.ps1" />
            </Component>
            <Component Id="LibReview" Guid="*" Win64="yes">
              <File Id="LibReview"
                    Name="Review.ps1"
                    Source="$(var.SourceDir)\lib\Review.ps1" />
            </Component>
            <Component Id="LibBackup" Guid="*" Win64="yes">
              <File Id="LibBackup"
                    Name="BackupRestore.ps1"
                    Source="$(var.SourceDir)\lib\BackupRestore.ps1" />
            </Component>
          </Directory>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="AppShortcuts" Name="System Optimizer">
          <Component Id="StartMenuShortcut" Guid="*" Win64="yes">
            <Shortcut Id="AppShortcut"
                      Name="System Optimizer"
                      Description="Tune performance and harden security in one GUI"
                      Target="[INSTALLFOLDER]SystemOptimizer.exe"
                      WorkingDirectory="INSTALLFOLDER" />
            <RemoveFolder Id="RemoveAppShortcuts" On="uninstall" />
            <RegistryValue Root="HKCU"
                           Key="Software\System Optimizer"
                           Name="installed"
                           Type="integer"
                           Value="1"
                           KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <Feature Id="MainFeature" Title="System Optimizer" Level="1">
      <ComponentRef Id="AppExe" />
      <ComponentRef Id="LibCommon" />
      <ComponentRef Id="LibService" />
      <ComponentRef Id="LibSecurity" />
      <ComponentRef Id="LibMaint" />
      <ComponentRef Id="LibRepair" />
      <ComponentRef Id="LibReview" />
      <ComponentRef Id="LibBackup" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Product>
</Wix>

